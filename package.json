{
    "name": "smtp-for-testing",
    "version": "0.2.1",
    "description": "SMTP server for creating and managing local mail inboxes for testing purposes, with Playwright support.",
    "keywords": [
        "playwright",
        "testing",
        "smtp",
        "mail"
    ],
    "license": "ISC",
    "author": "Joshua Mellon",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./playwright": {
            "types": "./dist/playwright.d.ts",
            "import": "./dist/playwright.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=18"
    },
    "private": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JoshuaMellon/smtp-for-testing.git"
    },
    "bugs": {
        "url": "https://github.com/JoshuaMellon/smtp-for-testing/issues"
    },
    "homepage": "https://github.com/JoshuaMellon/smtp-for-testing#readme",
    "scripts": {
        "clean": "rimraf dist",
        "build": "npm run clean && tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "api:start": "node --input-type=module -e \"import { createMailServerApi } from './dist/index.js'; await createMailServerApi({ port: 2525 });\"",
        "start": "node dist/index.js",
        "prepublishOnly": "npm run build && npm run test:run"
    },
    "dependencies": {
        "@asteasolutions/zod-to-openapi": "^9.1.0",
        "@scalar/express-api-reference": "^0.10.13",
        "express": "^5.2.1",
        "mailparser": "^3.9.14",
        "smtp-server": "^3.19.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/express": "^5.0.6",
        "@types/mailparser": "^3.4.6",
        "@types/node": "^26.1.2",
        "@types/smtp-server": "^3.5.13",
        "@types/supertest": "^7.2.1",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.6",
        "rimraf": "^6.0.1",
        "supertest": "^7.2.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.67.0",
        "vitest": "^4.1.10",
        "playwright": "^1.62.1"
    },
    "peerDependencies": {
        "playwright": ">=1.0.0"
    },
    "peerDependenciesMeta": {
        "playwright": {
            "optional": true
        }
    }
}