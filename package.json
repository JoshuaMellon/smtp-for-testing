{
    "name": "smtp-for-testing",
    "version": "1.0.0",
    "description": "SMTP server for creating and managing local mail inboxes for testing purposes, with Playwright support.",
    "keywords": [
        "playwright",
        "testing",
        "smtp",
        "mail"
    ],
    "license": "ISC",
    "author": "Joshua Mellon",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./playwright": {
            "types": "./dist/playwright.d.ts",
            "import": "./dist/playwright.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=18"
    },
    "private": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JoshuaMellon/smtp-for-testing.git"
    },
    "bugs": {
        "url": "https://github.com/JoshuaMellon/smtp-for-testing/issues"
    },
    "homepage": "https://github.com/JoshuaMellon/smtp-for-testing#readme",
    "scripts": {
        "clean": "rimraf dist",
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc --noEmit",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "start": "node dist/index.js",
        "prepublishOnly": "npm run build && npm run test:run"
    },
    "dependencies": {
        "playwright": "^1.62.1",
        "mailparser": "^3.9.14",
        "smtp-server": "^3.19.2"
    },
    "devDependencies": {
        "@types/mailparser": "^3.4.6",
        "@types/node": "^26.1.2",
        "@types/smtp-server": "^3.5.13",
        "@vitest/coverage-v8": "^4.1.10",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    }
}
